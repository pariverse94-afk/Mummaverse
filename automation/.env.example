# Template ONLY — copy to `automation/.env` for local runs and fill in real values.
# `.env` is gitignored. NEVER put real secrets in this example file, and never
# commit `.env`. In GitHub these live as Actions secrets, not in any file.

# Anthropic API key (console.anthropic.com). Swap this one value to change accounts.
ANTHROPIC_API_KEY=sk-ant-...

# Same value as the Cloudflare Pages ADMIN_PASSWORD secret (your /admin/ password).
ADMIN_PASSWORD=your-admin-password

# Pexels API key for the cover image (https://www.pexels.com/api/ — free).
PEXELS_API_KEY=your-pexels-key

# Optional. Defaults to https://mummaverse.in
SITE_URL=https://mummaverse.in

# Optional. false (default) = save each post as a hidden DRAFT to review in /admin/.
# Set to true to publish live automatically.
PUBLISH_LIVE=false
